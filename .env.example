# Absolute path of the ds-init project to look at (mounted as /project)
MLVIZ_PROJECT_PATH=/path/to/your/project
# Port on this machine
MLVIZ_PORT=8765
# Optional: issue titles and status from Linear. Without it only the issue IDs are shown.
LINEAR_API_KEY=
# Your user, so exported files belong to you (run `id -u` and `id -g`)
UID=1000
GID=1000
# Where ds-store is (it reads the runs and is built into the image). Default: the folder next to this repo
DS_STORE_PATH=../ds-store
